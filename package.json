{
  "name": "kk-growth-record",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "description": "KK personal growth records for desktop and mobile",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"wait-on http://localhost:5173 && electron electron/main.cjs\"",
    "web": "vite --host 0.0.0.0",
    "build": "vite build",
    "desktop": "electron electron/main.cjs",
    "package:dir": "npm run build && electron-builder --dir",
    "self-test": "node tests/self-test.mjs",
    "package:win": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.15",
    "docx": "^9.5.1",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "app-builder-bin": "^5.0.0-alpha.12",
    "concurrently": "^9.2.1",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.9",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.kk.growthrecord",
    "productName": "KK成长记录",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
